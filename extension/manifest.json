{
  "manifest_version": 3,
  "name": "VideoDrop",
  "short_name": "VideoDrop",
  "version": "1.3.3",
  "version_name": "1.3.3 Full",
  "minimum_chrome_version": "116",
  "description": "Choose a quality and download videos or MP3. YouTube, DASH and HLS, processed entirely inside Chrome. No helper required.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "webRequest",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VideoDrop — Download a video",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scanner.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open VideoDrop"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; worker-src 'self'"
  }
}
